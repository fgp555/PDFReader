<Window x:Class="PDFReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lector PDF" Height="760" Width="1200" MinHeight="560" MinWidth="820"
        Background="{DynamicResource WindowBackgroundBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OpenButton_Click" AutomationProperties.Name="Abrir archivo PDF"
                        ToolTip="Abrir PDF (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White"
                                   FontSize="16" Text="&#xE8E5;" Margin="0,0,8,0" />
                        <TextBlock Foreground="White" Text="Abrir PDF" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentTitle" Text="Lector PDF" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DocumentPath" Text="Abre un documento para comenzar" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}" Content="&#xE72B;"
                            IsEnabled="False" Click="BackButton_Click" Margin="0,0,8,0"
                            AutomationProperties.Name="Documento anterior" ToolTip="Documento anterior (Alt+Izquierda)" />
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButtonStyle}" Content="&#xE72A;"
                            IsEnabled="False" Click="ForwardButton_Click"
                            AutomationProperties.Name="Documento siguiente" ToolTip="Documento siguiente (Alt+Derecha)" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="RECIENTES" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="4,4,0,12" />
                    <ListBox x:Name="RecentFilesList" ItemsSource="{Binding RecentFiles}"
                             BorderThickness="0" Background="Transparent"
                             SelectionChanged="RecentFilesList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" CornerRadius="7" Background="{DynamicResource SurfaceMutedBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="PDF" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding Directory}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="12">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <wv2:WebView2 x:Name="PdfView" NavigationCompleted="PdfView_NavigationCompleted" />
                        <Grid x:Name="EmptyState" Background="{DynamicResource SurfaceBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                                <Border Width="76" Height="76" CornerRadius="18" Background="#FDEBEC"
                                        HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <TextBlock Text="PDF" Foreground="{DynamicResource AccentBrush}" FontSize="18"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Tu documento, listo para leer" FontSize="24" FontWeight="SemiBold"
                                           TextAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Abre un archivo PDF o arrástralo hasta esta ventana. El visor incluye búsqueda, zoom, impresión y descarga."
                                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,22" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Seleccionar un PDF"
                                        HorizontalAlignment="Center" Click="OpenButton_Click" />
                                <TextBlock Text="También puedes usar Ctrl+O" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#CCFFFFFF">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                                <TextBlock Text="Abriendo documento…" Margin="0,12,0,0" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusText" Text="Listo" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Ctrl+O  Abrir  ·  Ctrl+F  Buscar en el documento" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
