<Window x:Class="PDFReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lector PDF" Icon="Assets/PDFReader.ico" Height="760" Width="480" MinHeight="420" MinWidth="360"
        Style="{StaticResource WpfUi.Window}" WindowStyle="None" ResizeMode="CanResize"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged" Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="8"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="RecentFileButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource WpfUi.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource WpfUi.ControlPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WpfUi.Focus}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="FooterRow" Height="28" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource WpfUi.AppChrome}"
                BorderBrush="{DynamicResource WpfUi.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Menu Grid.Column="0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="_Archivo">
                        <MenuItem Header="_Nueva ventana" InputGestureText="Ctrl+N" Click="NewWindowMenuItem_Click" />
                        <MenuItem Header="_Abrir PDF…" InputGestureText="Ctrl+O" Click="OpenButton_Click" />
                        <MenuItem Header="_Guardar como…" InputGestureText="Ctrl+Shift+S" Click="SaveAsMenuItem_Click" />
                        <MenuItem x:Name="RecentFilesMenu" Header="Archivos _recientes" />
                        <Separator />
                        <MenuItem Header="_Imprimir…" InputGestureText="Ctrl+P" Click="PrintMenuItem_Click" />
                        <MenuItem Header="Mostrar en el _Explorador" Click="ShowInExplorerMenuItem_Click" />
                        <MenuItem Header="_Propiedades" Click="PropertiesMenuItem_Click" />
                        <MenuItem Header="_Configuración…" Click="SettingsMenuItem_Click" />
                        <Separator /><MenuItem Header="_Cerrar" InputGestureText="Ctrl+W" Click="CloseDocumentMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="_Ver">
                        <MenuItem Header="PDF _anterior" InputGestureText="Ctrl+Page Up" Click="PreviousPdfButton_Click" />
                        <MenuItem Header="PDF _siguiente" InputGestureText="Ctrl+Page Down" Click="NextPdfButton_Click" />
                        <Separator />
                        <MenuItem Header="Página anterior" Click="PreviousPageButton_Click" />
                        <MenuItem Header="Página siguiente" Click="NextPageButton_Click" />
                        <Separator />
                        <MenuItem Header="_Buscar…" InputGestureText="Ctrl+F" Click="FindMenuItem_Click" />
                        <MenuItem Header="_Acercar" InputGestureText="Ctrl++" Click="ZoomInMenuItem_Click" />
                        <MenuItem Header="A_lejar" InputGestureText="Ctrl+-" Click="ZoomOutMenuItem_Click" />
                        <MenuItem Header="Ajustar al _ancho" InputGestureText="Ctrl+0" Click="FitWidthMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Rotar a la _izquierda" Click="RotateLeftMenuItem_Click" />
                        <MenuItem Header="Rotar a la _derecha" Click="RotateRightMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="A_yuda"><MenuItem Header="Atajos de _teclado" Click="ShortcutsMenuItem_Click" /></MenuItem>
                </Menu>
                <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleRegion_MouseLeftButtonDown"
                      MouseRightButtonUp="TitleRegion_MouseRightButtonUp">
                    <TextBlock x:Name="DocumentTitle" Text="Lector PDF" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WpfUi.CaptionButton}" Click="MinimizeButton_Click"
                            AutomationProperties.Name="Minimizar" ToolTip="Minimizar">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE921;" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource WpfUi.CaptionButton}" Click="MaximizeRestoreButton_Click"
                            AutomationProperties.Name="Maximizar o restaurar" ToolTip="Maximizar o restaurar">
                        <TextBlock x:Name="MaximizeGlyph" Style="{StaticResource WpfUi.Icon}" Text="&#xE922;" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource WpfUi.CloseCaptionButton}" Click="CloseButton_Click"
                            AutomationProperties.Name="Cerrar" ToolTip="Cerrar">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE8BB;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Background="{DynamicResource WpfUi.Workspace}" ClipToBounds="True">
            <ScrollViewer x:Name="DocumentViewport" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" SizeChanged="DocumentViewport_SizeChanged"
                          ScrollChanged="DocumentViewport_ScrollChanged"
                          PreviewMouseDown="DocumentViewport_MouseDown"
                          PreviewMouseMove="DocumentViewport_MouseMove"
                          PreviewMouseUp="DocumentViewport_MouseUp"
                          PreviewMouseWheel="DocumentViewport_PreviewMouseWheel"
                          LostMouseCapture="DocumentViewport_LostMouseCapture"
                          MouseLeave="DocumentViewport_MouseLeave">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Resources>
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Margin="{TemplateBinding Padding}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Panel.ZIndex="2"
                                       Orientation="Vertical" HorizontalAlignment="Right"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Panel.ZIndex="2"
                                       Orientation="Horizontal" VerticalAlignment="Bottom"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </ScrollViewer.Template>
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <ContextMenu.Resources>
                            <Style x:Key="TextOnlyContextMenuItem" TargetType="MenuItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource WpfUi.Text}" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                                      VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                                               Foreground="{DynamicResource WpfUi.TextMuted}"
                                                               Margin="24,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Surface" Property="Background"
                                                            Value="{DynamicResource WpfUi.ControlHover}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Surface" Property="BorderBrush"
                                                            Value="{DynamicResource WpfUi.Focus}" />
                                                    <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>
                        <MenuItem Header="_Copiar texto" InputGestureText="Ctrl+C"
                                  Style="{StaticResource TextOnlyContextMenuItem}"
                                  Click="CopySelectedTextMenuItem_Click" />
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel x:Name="PagesPanel" VerticalAlignment="Top" />
            </ScrollViewer>
            <Grid x:Name="EmptyState" Background="{DynamicResource WpfUi.Workspace}">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24">
                    <StackPanel HorizontalAlignment="Center" Width="390">
                        <Border Width="62" Height="68" CornerRadius="5" BorderBrush="{DynamicResource WpfUi.BorderStrong}"
                                BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <TextBlock Text="PDF" Foreground="{DynamicResource PdfAccentBrush}" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="EmptyStateTitle" Text="Abre un documento PDF" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Name="EmptyStateDescription"
                                   Text="Selecciona un archivo o arrastra un PDF para abrirlo aquí."
                                   FontSize="13" Style="{StaticResource WpfUi.SecondaryText}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,8,0,20" />
                        <Button x:Name="EmptyStateAction" Style="{StaticResource WpfUi.PrimaryButton}" Content="Seleccionar un PDF"
                                HorizontalAlignment="Center" Click="OpenButton_Click" AutomationProperties.Name="Seleccionar un archivo PDF" />
                    </StackPanel>
                    <StackPanel x:Name="RecentFilesSection" Visibility="Collapsed" Width="390"
                                HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Border Height="1" Background="{DynamicResource WpfUi.Border}" Margin="0,0,0,14" />
                        <TextBlock Text="Abiertos recientemente" FontSize="12" FontWeight="SemiBold"
                                   Style="{StaticResource WpfUi.SecondaryText}" Margin="8,0,8,6" />
                        <StackPanel x:Name="RecentFilesPanel" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#E6191B1C">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="240">
                    <ProgressBar Height="4" IsIndeterminate="True" />
                    <TextBlock Text="Abriendo documento…" Margin="0,12,0,0" FontSize="12"
                               Style="{StaticResource WpfUi.SecondaryText}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="FindPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="8" Padding="6" CornerRadius="6" Background="{DynamicResource WpfUi.AppChrome}"
                    BorderBrush="{DynamicResource WpfUi.BorderStrong}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="FindTextBox" Width="220" Height="28" VerticalContentAlignment="Center"
                             TextChanged="FindTextBox_TextChanged" PreviewKeyDown="FindTextBox_PreviewKeyDown"
                             AutomationProperties.Name="Buscar texto" />
                    <TextBlock x:Name="FindResultText" MinWidth="54" Margin="8,0,2,0" VerticalAlignment="Center"
                               Style="{StaticResource WpfUi.MutedText}" TextAlignment="Center" />
                    <Button Style="{StaticResource WpfUi.FooterIconButton}" Click="FindPreviousButton_Click" ToolTip="Coincidencia anterior">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE76B;" />
                    </Button>
                    <Button Style="{StaticResource WpfUi.FooterIconButton}" Click="FindNextButton_Click" ToolTip="Coincidencia siguiente">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE76C;" />
                    </Button>
                    <Button Style="{StaticResource WpfUi.FooterIconButton}" Click="CloseFindButton_Click" ToolTip="Cerrar búsqueda">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Height="28" Style="{StaticResource WpfUi.StatusSurface}">
            <Grid>
                <StackPanel x:Name="PageNavigation" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="PreviousPdfButton" Style="{StaticResource WpfUi.FooterIconButton}"
                            IsEnabled="False" Click="PreviousPdfButton_Click"
                            AutomationProperties.Name="PDF anterior" ToolTip="PDF anterior de la carpeta">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE892;" />
                    </Button>
                    <TextBlock x:Name="PdfPositionText" Text="— / —" MinWidth="42"
                               VerticalAlignment="Center" TextAlignment="Center"
                               Style="{StaticResource WpfUi.MutedText}"
                               AutomationProperties.Name="Posición del PDF en la carpeta" />
                    <Button x:Name="NextPdfButton" Style="{StaticResource WpfUi.FooterIconButton}"
                            IsEnabled="False" Click="NextPdfButton_Click"
                            AutomationProperties.Name="PDF siguiente" ToolTip="PDF siguiente de la carpeta">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE893;" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Listo" FontSize="11" MinWidth="78" Margin="4,0,2,0"
                               Style="{StaticResource WpfUi.SecondaryText}" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="PreviousPageButton" Style="{StaticResource WpfUi.FooterIconButton}"
                            IsEnabled="False" Click="PreviousPageButton_Click" AutomationProperties.Name="Página anterior"
                            ToolTip="Página anterior (Page Up)">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE76B;" />
                    </Button>
                    <TextBox x:Name="PageNumberBox" Style="{StaticResource WpfUi.FooterPageNumberBox}" Text="—" IsEnabled="False"
                             PreviewKeyDown="PageNumberBox_PreviewKeyDown" LostKeyboardFocus="PageNumberBox_LostKeyboardFocus"
                             AutomationProperties.Name="Número de página" Visibility="Collapsed" />
                    <TextBlock x:Name="PageCountText" Text="/ —" Style="{StaticResource WpfUi.MutedText}"
                               VerticalAlignment="Center" Margin="3,0" MinWidth="24" Visibility="Collapsed" />
                    <Button x:Name="NextPageButton" Style="{StaticResource WpfUi.FooterIconButton}"
                            IsEnabled="False" Click="NextPageButton_Click" AutomationProperties.Name="Página siguiente"
                            ToolTip="Página siguiente (Page Down)">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE76C;" />
                    </Button>
                    <Button x:Name="DeletePdfButton" Style="{StaticResource WpfUi.FooterIconButton}"
                            IsEnabled="False" Click="DeletePdfButton_Click"
                            AutomationProperties.Name="Eliminar PDF actual" ToolTip="Enviar PDF actual a la Papelera">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE74D;" />
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" MinWidth="38" VerticalAlignment="Center"
                               TextAlignment="Center" Style="{StaticResource WpfUi.MutedText}" ToolTip="Zoom (Ctrl+rueda)" />
                    <Button x:Name="SaveInternetButton" Style="{StaticResource WpfUi.FooterIconButton}"
                            IsEnabled="False" Click="SaveInternetButton_Click"
                            AutomationProperties.Name="Guardar PDF de Internet en Documentos"
                            ToolTip="Guardar en Documentos (Ctrl+S)">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE74E;" />
                    </Button>
                    <Button x:Name="DocumentThemeButton" Style="{StaticResource WpfUi.FooterIconButton}"
                            IsEnabled="False" Click="DocumentThemeButton_Click" AutomationProperties.Name="Cambiar modo del documento"
                            ToolTip="Cambiar documento entre claro y oscuro">
                        <TextBlock x:Name="DocumentThemeGlyph" Style="{StaticResource WpfUi.Icon}" Text="&#xE708;" />
                    </Button>
                    <Button x:Name="CopyPageButton" Style="{StaticResource WpfUi.FooterIconButton}"
                            IsEnabled="False" Click="CopyPageButton_Click" AutomationProperties.Name="Copiar página como imagen"
                            ToolTip="Copiar página como imagen">
                        <TextBlock Style="{StaticResource WpfUi.Icon}" Text="&#xE8C8;" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="DocumentPath" Text="Arrastra un PDF para abrirlo en otra ventana" FontSize="11"
                           Style="{StaticResource WpfUi.MutedText}" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
